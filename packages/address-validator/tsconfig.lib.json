{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "allowJs": true,
        "checkJs": false,
        "composite": false,
        "incremental": false,
        "declarationMap": false,
        "sourceMap": false,
        "noEmit": false,
        "emitDeclarationOnly": false,
        "declaration": true,
        "module": "commonjs",
        "moduleResolution": "node"
    },
    "include": ["./src"],
    "exclude": ["./src/**/*.d.ts"]
}
